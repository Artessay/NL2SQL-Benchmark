# Database files stay local.
data/*/*/

# Only final artifacts in output/<dataset>/<method>/<vendor>/<model>/<linker>/
# are eligible for Git. Run directories, traces, logs and checkpoints stay local.
/output/**
!/output/*/
!/output/*/*/
!/output/*/*/*/
!/output/*/*/*/*/
!/output/*/*/*/*/*/
!/output/*/*/*/*/*/dev_pred.sql
!/output/*/*/*/*/*/dev_pred_gt.sql
!/output/*/*/*/*/*/eval_result_dev.json
!/output/*/*/*/*/*/summary.json
